          "type": "reading",
          "id": "L3_R1",
          "title": "Stay Calm and Think",
          "content": "In emergencies, staying calm is critical.\n\nA good first aider:\n• Stays calm\n• Thinks clearly\n• Acts step by step\n\nPanic leads to mistakes."
        },
        {
          "type": "mcq",
          "id": "L3_Q1",
          "title": "What is the best reaction in an emergency?",
          "instructions": "Choose the best answer.",
          "spriteAsset": "assets/spritesheet/Breathing.png",
          "choices": [
            "Panic and act quickly",
            "Stay calm and assess",
            "Wait for others to act"
          ],
          "correctIndex": 1,
          "hint": "Think control.",
          "correctExplanation": "Staying calm allows you to think clearly and act correctly.",
          "incorrectExplanation": "Panic leads to poor decisions."
        },
        {
          "type": "mcq",
          "id": "L3_Q2",
          "title": "Why is panic dangerous?",
          "instructions": "Choose the best answer.",
          "spriteAsset": "assets/spritesheet/Breathing.png",
          "choices": [
            "It saves time",
            "It improves decisions",
            "It leads to mistakes"
          ],
          "correctIndex": 2,
          "hint": "Think clearly vs not.",
          "correctExplanation": "Panic reduces clear thinking and increases mistakes.",
          "incorrectExplanation": "Good decisions require calm thinking."
        },
        {
          "type": "order",
          "id": "L3_Q3",
          "title": "Arrange the correct mindset steps",
          "instructions": "Put in correct order.",
          "spriteAsset": "assets/spritesheet/Breathing.png",
          "choices": [
            "Act",
            "Think",
            "Stay calm"
          ],
          "correctOrder": [2, 1, 0],
          "hint": "Mental before action.",
          "correctExplanation": "Stay calm → think → act.",
          "incorrectExplanation": "You must control yourself before acting."
        },
        {
          "type": "text",
          "id": "L3_Q4",
          "title": "Why is staying calm important?",
          "instructions": "Explain briefly.",
          "spriteAsset": "assets/spritesheet/Breathing.png",
          "aiPrompt": "Explain why calmness improves emergency response",
          "hint": "Think decision-making."
        }
      ]
